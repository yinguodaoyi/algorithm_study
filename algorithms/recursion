//A function is a part of the main function that is taken out and written separately, such as writing an initialization function separately and calling it in the main function
//If we call it within the function itself, we can achieve a result similar to a loop structure, and simplify some structures that are difficult to write using loops
#include<iostream>
using namespace std;
int factorial1（int n）
{
  int m=1;
  for(int i=1;i<=n;i++)
  {
    m*=n;
  }
  return m;
}
int factorial2(int n)
{
  if(n==1) return 1;
  return factorial2(n-1)*n;
}
int main()
{
  int n,m1,m2;
  cin>>n;
  m1=factorial1(n);
  m2=factorial2(n);
  cout<<m1<<" "<<m2<<"\n";
}
